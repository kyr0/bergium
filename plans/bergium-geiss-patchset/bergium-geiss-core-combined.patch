@@ -0,0 +1,85 @@
+/**
+ * Geiss 4.30 8-bit initialization in global RNG consumption order.
+ *
+ * Source: `main.cpp::FX_Init`. This object intentionally owns values that look
+ * unrelated: splitting them into independently seeded helpers changes every
+ * later mode/effect/palette decision.
+ */
+
+import { f32 } from "./GeissNumeric.js";
+import { MsvcRandom } from "./MsvcRandom.js";
+import {
+  createDotChaserState8,
+  createShadeBobParameters,
+  type ExactEffects8State,
+} from "./ExactEffects8.js";
+
+export interface GeissInitialization8Options {
+  readonly seed: number;
+  readonly width: number;
+  readonly height: number;
+  readonly centerX: number;
+  readonly centerY: number;
+  readonly cut?: number;
+  readonly hideCut?: number;
+  readonly fpsAtModeSwitch?: number;
+}
+
+export interface GeissInitialization8Result {
+  readonly rng: MsvcRandom;
+  readonly effectState: ExactEffects8State;
+  readonly scatter: Float32Array;
+  readonly paletteFrequencies: Float32Array;
+  readonly mode7RandomArray: Float32Array;
+}
+
+const SCATTER_VALUES = 226;
+const MODE7_RANDOM_VALUES = 2345;
+
+export function initializeGeiss8(options: GeissInitialization8Options): GeissInitialization8Result {
+  const rng = new MsvcRandom(options.seed);
+
+  // Exact first RNG consumer in FX_Init after srand().
+  const chaserOffset = rng.nextInt(40000);
+
+  const scatter = new Float32Array(SCATTER_VALUES);
+  for (let i = 0; i < scatter.length; i++) {
+    scatter[i] = f32(0.05 - 0.025 * rng.nextInt(1000) * 0.001);
+  }
+
+  // chaser_x/y and sqrt_tab consume no randomness.
+  const shade = createShadeBobParameters(rng);
+
+  const paletteFrequencies = new Float32Array(6);
+  for (let i = 0; i < paletteFrequencies.length; i++) {
+    paletteFrequencies[i] = f32(rng.nextInt(1000) * 0.001 * 0.01 + 0.02);
+  }
+
+  const mode7RandomArray = new Float32Array(MODE7_RANDOM_VALUES);
+  for (let i = 0; i < mode7RandomArray.length; i++) {
+    mode7RandomArray[i] = f32(rng.nextInt(100) * 0.0005);
+  }
+
+  const effectState: ExactEffects8State = {
+    width: options.width,
+    height: options.height,
+    centerX: options.centerX,
+    centerY: options.centerY,
+    cut: options.cut ?? 4,
+    hideCut: options.hideCut ?? 4,
+    fpsAtModeSwitch: options.fpsAtModeSwitch ?? 30,
+    floatFrame: 0,
+    intFrame: 0,
+    chaserOffset,
+    mode: 1,
+    centerDwindle: 1,
+    solarMax: 400,
+    gridDirection: -1,
+    soundActive: false,
+    soundEmpty: true,
+    shade,
+    dotChaser: createDotChaserState8(),
+  };
+
+  return { rng, effectState, scatter, paletteFrequencies, mode7RandomArray };
+}
diff --git a/packages/bergium/src/pipelines/geiss/reference/GeissNumeric.ts b/packages/bergium/src/pipelines/geiss/reference/GeissNumeric.ts
new file mode 100644
index 0000000..ad47342
--- /dev/null
+++ b/packages/bergium/src/pipelines/geiss/reference/GeissNumeric.ts
@@ -0,0 +1,67 @@
+/**
+ * Explicit numeric operations used by the Geiss compatibility profiles.
+ *
+ * The original renderer relies on C/C++ conversion rules that JavaScript usually
+ * approximates accidentally. Keeping those rules named makes byte behavior
+ * reviewable and prevents "helpful" clamps from changing the feedback system.
+ */
+
+/** Round a value to IEEE-754 binary32, matching assignment to a C `float`. */
+export const f32 = Math.fround;
+
+/** C/C++ float-to-integer conversion for finite values: truncate toward zero. */
+export function cTrunc(value: number): number {
+  if (!Number.isFinite(value)) {
+    throw new RangeError(`Cannot convert non-finite value ${value} to a C integer`);
+  }
+  return Math.trunc(value);
+}
+
+/** Assignment/conversion to an unsigned 8-bit byte. */
+export function u8(value: number): number {
+  return cTrunc(value) & 0xff;
+}
+
+/** Assignment/conversion to a signed 8-bit integer. */
+export function i8(value: number): number {
+  const byte = u8(value);
+  return byte < 0x80 ? byte : byte - 0x100;
+}
+
+/** Assignment/conversion to a signed 16-bit integer. */
+export function i16(value: number): number {
+  const word = cTrunc(value) & 0xffff;
+  return word < 0x8000 ? word : word - 0x10000;
+}
+
+/** `sinf`-shaped operation: binary32 input and binary32 result. */
+export function sinf(value: number): number {
+  return f32(Math.sin(f32(value)));
+}
+
+/** `cosf`-shaped operation: binary32 input and binary32 result. */
+export function cosf(value: number): number {
+  return f32(Math.cos(f32(value)));
+}
+
+/** `sqrtf`-shaped operation: binary32 input and binary32 result. */
+export function sqrtf(value: number): number {
+  return f32(Math.sqrt(f32(value)));
+}
+
+/** Unsigned-byte `+=` semantics: integer promotion followed by byte wrapping. */
+export function addU8Wrapping(frame: Uint8Array, index: number, value: number): void {
+  frame[index] = u8(frame[index]! + cTrunc(value));
+}
+
+/** Saturating byte addition used by the Nuclide effects. */
+export function addU8Saturating(frame: Uint8Array, index: number, value: number): void {
+  const next = frame[index]! + cTrunc(value);
+  frame[index] = next > 255 ? 255 : next < 0 ? 0 : next;
+}
+
+/** Source-style maximum write with byte conversion. */
+export function maxU8(frame: Uint8Array, index: number, value: number): void {
+  const byte = u8(value);
+  if (frame[index]! < byte) frame[index] = byte;
+}
