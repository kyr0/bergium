+++ b/packages/bergium/src/pipelines/geiss/reference/ExactMapBuilder.ts
@@ -0,0 +1,106 @@
+/**
+ * Source-timed pending-map construction.
+ *
+ * Geiss does not normally generate a complete map at mode switch. It advances a
+ * linear `y_map_pos` budget each frame. This matters for mode 14 because every
+ * generated pixel consumes the global `rand()` stream; eager generation changes
+ * later effect, palette and title choices even if the final map is identical.
+ */
+
+import type { MapParameters, MapTexel, RandomSource } from "./MapField.js";
+import { quantizeMapTexelExact } from "./MapField.js";
+import { interpolationWeightSum } from "./ClassicConfig.js";
+
+export interface ExactMapProgress {
+  readonly generatedPixels: number;
+  readonly totalActivePixels: number;
+  readonly frameCount: number;
+  readonly complete: boolean;
+}
+
+function identityTexel(x: number, y: number, p: MapParameters): MapTexel {
+  const sum = Math.trunc(p.weightSum * interpolationWeightSum(p.width, p.height) / 256) & 0xff;
+  return { sourceX: x, sourceY: y, w00: sum, w10: 0, w01: 0, w11: 0 };
+}
+
+export class ExactMapBuilder {
+  private readonly map: MapTexel[];
+  private readonly start: number;
+  private readonly end: number;
+  private position: number;
+  private framesCrunching = 0;
+
+  public constructor(
+    private readonly parameters: MapParameters,
+    private readonly cut: number,
+    private readonly framesTillAutoSwitch: number,
+    private readonly rng: RandomSource,
+  ) {
+    const { width, height } = parameters;
+    if (!Number.isInteger(cut) || cut < 0 || cut * 2 >= height) {
+      throw new RangeError(`Invalid map cut ${cut} for height ${height}`);
+    }
+    if (!Number.isInteger(framesTillAutoSwitch) || framesTillAutoSwitch <= 0) {
+      throw new RangeError(`framesTillAutoSwitch must be positive, got ${framesTillAutoSwitch}`);
+    }
+
+    this.start = cut * width;
+    this.end = (height - cut) * width;
+    this.position = this.start;
+    this.map = new Array<MapTexel>(width * height);
+
+    // Process_Map only covers active rows. Identity border entries make the
+    // portable full-frame backend deterministic without consuming RNG.
+    for (let y = 0; y < cut; y++) {
+      for (let x = 0; x < width; x++) this.map[y * width + x] = identityTexel(x, y, parameters);
+    }
+    for (let y = height - cut; y < height; y++) {
+      for (let x = 0; x < width; x++) this.map[y * width + x] = identityTexel(x, y, parameters);
+    }
+  }
+
+  /**
+   * Generate exactly this frame's source budget. `rush=true` finishes the active
+   * map immediately but still consumes random values in raster order.
+   */
+  public step(rush = false): ExactMapProgress {
+    if (this.position >= this.end) return this.progress();
+    this.framesCrunching++;
+
+    const { width, height } = this.parameters;
+    const activeRows = height - this.cut * 2;
+    let endPosition = width * (
+      this.cut + (this.framesCrunching / this.framesTillAutoSwitch) * activeRows
+    );
+    endPosition = Math.trunc(endPosition);
+    if (rush || endPosition > this.end) endPosition = this.end;
+
+    for (; this.position < endPosition; this.position++) {
+      const y = Math.trunc(this.position / width);
+      const x = this.position - y * width;
+      this.map[this.position] = quantizeMapTexelExact(x, y, this.parameters, this.rng);
+    }
+    return this.progress();
+  }
+
+  public progress(): ExactMapProgress {
+    return {
+      generatedPixels: this.position - this.start,
+      totalActivePixels: this.end - this.start,
+      frameCount: this.framesCrunching,
+      complete: this.position >= this.end,
+    };
+  }
+
+  public currentMap(): readonly MapTexel[] {
+    if (this.position < this.end) {
+      throw new Error(`Pending map is incomplete: ${this.position - this.start}/${this.end - this.start} pixels`);
+    }
+    return this.map;
+  }
+
+  /** Test/debug view. Entries after the current position may still be undefined. */
+  public partialMap(): readonly (MapTexel | undefined)[] {
+    return this.map;
+  }
+}
diff --git a/packages/bergium/src/pipelines/geiss/reference/GeissClassicFrame8.ts b/packages/bergium/src/pipelines/geiss/reference/GeissClassicFrame8.ts
new file mode 100644
index 0000000..3ddcd0e
--- /dev/null
+++ b/packages/bergium/src/pipelines/geiss/reference/GeissClassicFrame8.ts
@@ -0,0 +1,106 @@
+/**
+ * Allocation-free portable 8-bit classic frame executor.
+ *
+ * This is the integration seam for the source-shaped CPU backend. It preserves
+ * Geiss's observable pass order while deliberately naming the current warp as
+ * `portable-four-tap`; the active historical x86 pair-accumulator kernel must be
+ * added as a separate backend rather than falsely relabeling this implementation.
+ */
+
+import type { RandomSource, MapTexel } from "./MapField.js";
+import { warpIntensity8, type IntensityFrame } from "./FeedbackWarp.js";
+import {
+  renderExactEffects8,
+  type ExactEffectSelection8,
+  type ExactEffects8State,
+} from "./ExactEffects8.js";
+import { renderWave, type WaveRenderInput } from "./WaveformRenderer.js";
+import { advanceFrameClock, createFrameClock, type FrameClock } from "./FrameClock.js";
+
+export type GeissWarp8Profile = "portable-four-tap";
+
+export interface GeissClassicFrame8Step {
+  readonly fps: number;
+  readonly effects: ExactEffectSelection8;
+  /** Ordered post-warp mutation, e.g. RenderDots/audio-triggered Nuclide. */
+  readonly postWarp?: (frame: IntensityFrame) => void;
+  /** Waveform is always written after the warp and post-warp dots. */
+  readonly waveform?: Omit<WaveRenderInput, "frame">;
+}
+
+export class GeissClassicFrame8 {
+  public readonly warpProfile: GeissWarp8Profile = "portable-four-tap";
+  public readonly clock: FrameClock = createFrameClock();
+
+  private front: IntensityFrame;
+  private back: IntensityFrame;
+  private map: readonly MapTexel[];
+
+  public constructor(
+    private readonly width: number,
+    private readonly height: number,
+    map: readonly MapTexel[],
+    private readonly effectState: ExactEffects8State,
+    private readonly rng: RandomSource,
+  ) {
+    const pixels = width * height;
+    if (map.length !== pixels) {
+      throw new RangeError(`Map has ${map.length} entries, expected ${pixels}`);
+    }
+    if (effectState.width !== width || effectState.height !== height) {
+      throw new RangeError("Effect state dimensions do not match the frame executor");
+    }
+    this.map = map;
+    // The source allocates safety padding. Typed arrays make out-of-range writes a
+    // no-op, but retaining padding also makes source-adjacent effects auditable.
+    this.front = new Uint8Array(pixels + 2048);
+    this.back = new Uint8Array(pixels + 2048);
+  }
+
+  public setMap(map: readonly MapTexel[]): void {
+    if (map.length !== this.width * this.height) {
+      throw new RangeError(`Map has ${map.length} entries, expected ${this.width * this.height}`);
+    }
+    this.map = map;
+  }
+
+  /** Source initialization is zero; explicit seeding exists only for fixtures. */
+  public seedFront(bytes: Uint8Array): void {
+    if (bytes.length !== this.width * this.height) {
+      throw new RangeError(`Seed has ${bytes.length} bytes, expected ${this.width * this.height}`);
+    }
+    this.front.fill(0);
+    this.front.set(bytes);
+  }
+
+  public clear(): void {
+    this.front.fill(0);
+    this.back.fill(0);
+  }
+
+  public step(input: GeissClassicFrame8Step): Uint8Array {
+    // `RenderFX` advances these counters before evaluating any effect.
+    advanceFrameClock(this.clock, input.fps);
+    this.effectState.floatFrame = this.clock.floatframe;
+    this.effectState.intFrame = this.clock.intframe;
+
+    renderExactEffects8(this.front, this.effectState, input.effects, this.rng);
+    warpIntensity8(this.front, this.back, this.map, this.width);
+    input.postWarp?.(this.back);
+    if (input.waveform) renderWave({ ...input.waveform, frame: this.back });
+
+    const previous = this.front;
+    this.front = this.back;
+    this.back = previous;
+    return this.currentFrame();
+  }
+
+  /** Visible scalar frame; safety padding is never exposed to presentation. */
+  public currentFrame(): Uint8Array {
+    return this.front.subarray(0, this.width * this.height);
+  }
+
+  public scratchBackFrame(): Uint8Array {
+    return this.back.subarray(0, this.width * this.height);
+  }
+}
diff --git a/packages/bergium/src/pipelines/geiss/reference/GeissInitialization8.ts b/packages/bergium/src/pipelines/geiss/reference/GeissInitialization8.ts
