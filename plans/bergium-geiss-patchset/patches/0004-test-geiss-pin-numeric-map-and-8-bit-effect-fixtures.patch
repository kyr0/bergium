@@ -0,0 +1,76 @@
+import { test } from "vitest";
+import assert from "node:assert/strict";
+import { cTrunc, i16, i8, u8 } from "../../src/pipelines/geiss/reference/GeissNumeric.js";
+import {
+  quantizeMapTexel,
+  quantizeMapTexelExact,
+  type MapParameters,
+} from "../../src/pipelines/geiss/reference/MapField.js";
+import { MsvcRandom } from "../../src/pipelines/geiss/reference/MsvcRandom.js";
+
+const params = (overrides: Partial<MapParameters> = {}): MapParameters => ({
+  mode: 2,
+  width: 640,
+  height: 480,
+  centerX: 320,
+  centerY: 240,
+  scale1: 2.001,
+  scale2: 1,
+  turn1: 0,
+  turn2: 0,
+  f1: 0,
+  f2: 0,
+  f3: 0,
+  damping: 1,
+  weightSum: 256,
+  fpsAtModeSwitch: 30,
+  nuclideSelected: false,
+  influences: [],
+  randomNoise: new Float32Array(2345),
+  randomNoisePosition: { value: 0 },
+  ...overrides,
+});
+
+test("C numeric helpers preserve truncation and signed/unsigned wrapping", () => {
+  assert.equal(cTrunc(-1.9), -1);
+  assert.equal(cTrunc(1.9), 1);
+  assert.equal(u8(-1), 255);
+  assert.equal(u8(257.9), 1);
+  assert.equal(i8(255), -1);
+  assert.equal(i16(0xffff), -1);
+  assert.equal(i16(0x8000), -32768);
+});
+
+test("MsvcRandom checkpoint restores both sequence state and call count", () => {
+  const rng = new MsvcRandom(1);
+  assert.deepEqual([rng.nextRaw(), rng.nextRaw(), rng.nextRaw()], [41, 18467, 6334]);
+  const checkpoint = rng.checkpoint();
+  const suffix = [rng.nextRaw(), rng.nextRaw(), rng.nextRaw()];
+  assert.equal(rng.callCount, 6);
+  rng.restore(checkpoint);
+  assert.equal(rng.callCount, 3);
+  assert.deepEqual([rng.nextRaw(), rng.nextRaw(), rng.nextRaw()], suffix);
+});
+
+test("source-exact map quantization retains negative fractions and byte wrapping", () => {
+  const safe = quantizeMapTexel(0, 2, params(), new MsvcRandom(1));
+  const exact = quantizeMapTexelExact(0, 2, params(), new MsvcRandom(1));
+
+  assert.deepEqual(safe, {
+    sourceX: 0,
+    sourceY: 2,
+    w00: 19,
+    w10: 40,
+    w01: 61,
+    w11: 131,
+  });
+  assert.deepEqual(exact, {
+    sourceX: 0,
+    sourceY: 2,
+    w00: 100,
+    w10: 212,
+    w01: 237,
+    w11: 216,
+  });
+  assert.notDeepEqual(exact, safe);
+});
